{
  "name": "cleaning-admin-dashboard-backend",
  "version": "0.1.0",
  "description": "Multi-tenant backend for Cleanilo, Hamburg Teppichreinigung, and Teppichreinigen Lassen.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/db/migrate.js && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "prepare": "husky || true",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node dist/db/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:local": "tsx src/db/seed-local.ts",
    "db:seed:prod": "tsx src/db/seed-prod.ts",
    "db:seed:n8n-test": "tsx src/db/seed-n8n-test.ts"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.2",
    "@fastify/websocket": "^11.2.0",
    "@types/qrcode": "^1.5.6",
    "better-auth": "^1.0.21",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "nanoid": "^5.1.11",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "resend": "^6.12.3",
    "stripe": "^22.1.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@eslint/js": "9.39.4",
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "pino-pretty": "^13.0.0",
    "prettier": "3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.60.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
