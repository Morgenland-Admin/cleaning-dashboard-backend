NODE_ENV=development
PORT=8000
HOST=0.0.0.0
APP_BASE_URL=https://reinigungs-portal.com

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cleaning_dashboard

# Better Auth
BETTER_AUTH_SECRET=replace-with-long-random-string
BETTER_AUTH_URL=https://api.reinigungs-portal.com

# CORS
CORS_ORIGINS=https://reinigungs-portal.com,https://cleanilo.de,https://hamburg-teppichreinigung.de,https://teppichreinigen-lassen.de

# Email
RESEND_API_KEY=
ADMIN_FROM_EMAIL=admin@reinigungs-portal.com
ADMIN_FROM_NAME=Reinigungs-Portal
# Feedback-loop guard: suppress confirmation/notification mail for inquiries
# whose contact address is one of our own domains. Comma-separated.
OWN_EMAIL_DOMAINS=cleanilo.de,hamburg-teppichreinigung.de,teppichreinigen-lassen.de,reinigungs-portal.com
# Hard backstop: max inquiries a single contact email may create per hour.
INQUIRY_MAX_PER_EMAIL_PER_HOUR=10
RESEND_API_KEY_HAMBURG=
RESEND_API_KEY_CLEANILO=
RESEND_API_KEY_TRL=

# Voice-AI / callback geo-routing
# Reference point + radius: human callback within radius of Hamburg, AI queue outside.
CALLBACK_GEO_REF_LAT=53.53165
CALLBACK_GEO_REF_LNG=9.98526
CALLBACK_GEO_RADIUS_KM=100
# User id human callbacks are assigned to by default.
CALLBACK_DEFAULT_HUMAN_ASSIGNEE_ID=
# Shared secret for POST /internal/inquiries (X-Intake-Token); unset = 503.
INQUIRY_INTAKE_TOKEN=

# S3 storage
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=reinigungs-portal-uploads
S3_PUBLIC_BASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# PayPal (native Orders v2; PAYPAL_ENV=sandbox|live)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# n8n
N8N_CANCEL_WEBHOOK_URL=

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@reinigungs-portal.com

# Claude / Anthropic text assistant (the in-dashboard "✦ Claude" box).
# Unset = /admin/ai/* returns 503 and the box shows a "not configured" hint.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024

# Error tracking (optional)
SENTRY_DSN=

# Meta Conversions API (per-brand). Needs both pixel id + token, else no-op.
# TEST_EVENT_CODE is optional (Events Manager → Test Events).
META_PIXEL_ID_HAMBURG=
META_CAPI_TOKEN_HAMBURG=
META_TEST_EVENT_CODE_HAMBURG=

# Seed credentials
ADMIN_PASSWORD=
N8N_ROBOT_PASSWORD=

# Callback-owner user — seeded only when CALLBACK_USER_PASSWORD is set.
CALLBACK_USER_EMAIL=callbacks@reinigungs-portal.com
CALLBACK_USER_PASSWORD=
CALLBACK_USER_FIRST_NAME=Callback
CALLBACK_USER_LAST_NAME=Team

# ── Calendly (pickup / on-site appointments) ──
CALENDLY_API_TOKEN=
# https://api.calendly.com/event_types/<uuid> — read it with:
#   node --import tsx scripts/calendly-setup.ts event-types
CALENDLY_PICKUP_EVENT_TYPE_URI=
# Signing key of the webhook subscription; printed once by:
#   node --import tsx scripts/calendly-setup.ts webhook --url <backend>/storefront/orders/webhook/calendly
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_TIMEZONE=Europe/Berlin
# Test seam only — point at a local Calendly stub. Must stay empty in production.
CALENDLY_API_BASE=
