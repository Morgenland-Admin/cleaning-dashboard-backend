NODE_ENV=development
PORT=8000
HOST=0.0.0.0
APP_BASE_URL=https://reinigungs-portal.com

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cleaning_dashboard

# Better Auth
BETTER_AUTH_SECRET=replace-with-long-random-string
BETTER_AUTH_URL=https://api.reinigungs-portal.com

# CORS
CORS_ORIGINS=https://reinigungs-portal.com,https://cleanilo.de,https://hamburg-teppichreinigung.de,https://teppichreinigen-lassen.de

# Email
RESEND_API_KEY=
ADMIN_FROM_EMAIL=admin@reinigungs-portal.com
ADMIN_FROM_NAME=Reinigungs-Portal
RESEND_API_KEY_HAMBURG=
RESEND_API_KEY_CLEANILO=
RESEND_API_KEY_TRL=

# Seed credentials
ADMIN_PASSWORD=
N8N_ROBOT_PASSWORD=

# S3 storage
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=reinigungs-portal-uploads

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# PayPal (native Orders v2 — funds land directly in the PayPal business account)
# Create an app at https://developer.paypal.com → REST API apps → get Client ID + Secret.
# PAYPAL_ENV=sandbox uses api-m.sandbox.paypal.com; set to "live" for production.
# PAYPAL_WEBHOOK_ID comes from the webhook you register in the PayPal dashboard.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# n8n
N8N_CANCEL_WEBHOOK_URL=

# Web Push (VAPID) — generate once with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@reinigungs-portal.com

# Error tracking (optional) — also run `pnpm add @sentry/node` to enable.
SENTRY_DSN=